{
  "name": "mindmap",
  "version": "3.5.17-develop-pedago.0",
  "description": "ENT mindmap module.",
  "homepage": "https://github.com/OPEN-ENT-NG/mindmap#readme",
  "bugs": {
    "url": "https://github.com/OPEN-ENT-NG/mindmap/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OPEN-ENT-NG/mindmap"
  },
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "pre-commit": "lint-staged",
    "prepare": "cd .. && husky frontend/.husky || true",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ]
  },
  "dependencies": {
    "@edifice.io/react": "develop-pedago",
    "@edifice.io/client": "develop-pedago",
    "@edifice.io/bootstrap": "develop-pedago",
    "@edifice-wisemapping/editor": "0.7.10",
    "@react-spring/web": "9.7.5",
    "@tanstack/react-query": "5.108.0",
    "i18next": "23.16.8",
    "i18next-http-backend": "2.7.3",
    "ode-explorer": "develop-pedago",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "14.1.3",
    "react-router-dom": "6.30.6",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@axe-core/react": "4.14.0",
    "@eslint/js": "9.39.5",
    "@tanstack/react-query-devtools": "5.108.0",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "18.19.130",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.5.2",
    "msw": "2.15.0",
    "nx": "19.8.14",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "5.4.21",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "nx": {}
}